# ---------------------------------------------------------------------------
# Inquiry delivery (/api/inquiry)
#
# If neither option below is configured, the route returns 503 and the contact
# form shows the direct inbox address rather than silently accepting and
# dropping the submission.
# ---------------------------------------------------------------------------

# Option 1 (in use) — Resend.
# Set RESEND_API_KEY as a SECRET in Cloudflare, never a plaintext variable.
RESEND_API_KEY=

# Sending identity. Must be a domain verified in Resend.
# A SUBDOMAIN is used deliberately: atlasofftake.com itself carries Google
# Workspace MX and SPF records for the real inquiries@ mailbox, and verifying a
# subdomain leaves those untouched.
# Defaults to "Atlas Offtake <inquiries@send.atlasofftake.com>" if unset.
INQUIRY_FROM=

# Where inquiries land. Defaults to inquiries@atlasofftake.com if unset.
INQUIRY_TO=

# Option 2 (fallback) — any endpoint that accepts a JSON POST: CRM intake,
# Zapier/Make catch hook, form service. Only used when RESEND_API_KEY is unset.
# Receives: { source, receivedAt, name, company, email, area, message }
INQUIRY_WEBHOOK_URL=
